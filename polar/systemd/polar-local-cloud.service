[Unit]
Description=Polar feeder local cloud service
After=network-online.target mosquitto.service
Wants=network-online.target
Requires=mosquitto.service

[Service]
Type=simple
EnvironmentFile=/etc/default/polar
ExecStart=/root/polar-local-cloud
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
