+# ─── LOCAL PATCH4 (3.1.54): tz payload for NTP answers ──────────────────────
+def _p4_tz_payload(ts_ms):
+    """Timezone/DST payload matching the reference NTP answer semantics."""
+    from datetime import datetime, timedelta, timezone as _tz
+    try:
+        from zoneinfo import ZoneInfo
+        try:
+            with open("/etc/timezone") as _f:
+                tzname = _f.read().strip() or "America/Los_Angeles"
+        except Exception:
+            tzname = "America/Los_Angeles"
+        tz = ZoneInfo(tzname)
+    except Exception:
+        tz = None
+
+    now = datetime.fromtimestamp(ts_ms / 1000.0, tz) if tz else datetime.fromtimestamp(ts_ms / 1000.0).astimezone()
+
+    def _offset_at(dt):
+        return dt.utcoffset() or timedelta()
+
+    cur = _offset_at(now)
+
+    transitions = []
+    probe = now.replace(minute=0, second=0, microsecond=0)
+    state = bool(probe.dst())
+    for _ in range(9000):  # ~12.5 months of hours
+        nxt = probe + timedelta(hours=1)
+        if bool(nxt.dst()) != state:
+            lo, hi = probe, nxt
+            for _ in range(10):
+                mid = lo + (hi - lo) / 2
+                if bool(mid.dst()) == state:
+                    lo = mid
+                else:
+                    hi = mid
+            transitions.append(hi)
+            state = bool(hi.dst())
+            if len(transitions) == 2:
+                break
+        probe = nxt
+
+    def _epoch_ms(dt):
+        return int(dt.timestamp() * 1000)
+
+    t1 = transitions[0] if transitions else None
+    t2 = transitions[1] if len(transitions) > 1 else None
+    off1 = _offset_at(t1 + timedelta(hours=1)) if t1 else cur
+    off2 = _offset_at(t2 + timedelta(hours=1)) if t2 else cur
+
+    return {
+        "timezoneOffsetSeconds": int(cur.total_seconds()),
+        "nextDSTOffsetSeconds": int(off1.total_seconds()),
+        "nextDSTTransitionTs": _epoch_ms(t1) if t1 else 0,
+        "secondNextDSTOffsetSeconds": int(off2.total_seconds()),
+        "secondNextDSTTransitionTs": _epoch_ms(t2) if t2 else 0,
+        "timezone": int(cur.total_seconds() // 3600),
+    }
+
 def wait_for(event: threading.Event, timeout: float, description: str) -> None:
     if not event.wait(timeout):
         raise TimeoutError(f"timed out waiting for {description}")
