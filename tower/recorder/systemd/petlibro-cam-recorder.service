[Unit]
Description=Petlibro Tower camera recorder (motion/feed clips)
After=network-online.target
Wants=network-online.target
RequiresMountsFor=CLIPS_DIR_PLACEHOLDER

[Service]
EnvironmentFile=/etc/default/petlibro-cam
Type=simple
ExecStart=/root/petlibro-cam-recorder
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
